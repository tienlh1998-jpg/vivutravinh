# ViVuTraVinh Environment Configuration Example
# Sao chép tệp này thành .env hoặc cấu hình trên nền tảng Vercel / Serverless.
# LƯU Ý BẢO MẬT: Tuyệt đối KHÔNG commit khóa SUPABASE_SERVICE_ROLE_KEY, ADMIN_SECRET, IMPORT_SECRET lên repository công khai.

# --- Cấu hình Supabase Frontend & Public Read ---
# Khóa anon có quyền đọc hạn chế thông qua Row Level Security (RLS)
SUPABASE_URL=https://foyraoimhksfvlxndwxr.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZveXJhb2ltaGtzZnZseG5kd3hyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3MjkwNzAsImV4cCI6MjA5NTMwNTA3MH0.ARJ173UkVNCichCiJmVrbp2aTByVoXnSEAIsIvbnYJ8

# --- Cấu hình Backend Serverless API (Chỉ nằm ở server, không lộ ra frontend) ---
# Khóa Service Role có quyền bypass RLS để quản trị dữ liệu
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret bảo vệ các API quản trị (/api/admin-places, /api/admin-comments)
ADMIN_SECRET=your-secure-admin-secret-here

# Secret bảo vệ API nhập địa điểm tự động (/api/import-place từ Google Apps Script)
IMPORT_SECRET=your-secure-import-secret-here

# Cổng máy chủ cục bộ (tùy chọn, mặc định 8000)
PORT=8000
